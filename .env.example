
PIER-VIBE Environment Variables

Predictive Intelligence Engine for Resonance, Vibration, and Integrity in Bridge Environments

============= Bridge Parameters =============

PIER_VIBE_WATER_DEPTH=25.0
PIER_VIBE_PIER_DIAMETER=3.5
PIER_VIBE_PIER_HEIGHT=15.0

============= Scour Parameters (SSSE) =============

PIER_VIBE_D50=0.5
PIER_VIBE_SEDIMENT_TYPE=sand
PIER_VIBE_CRITICAL_SCOUR_DEPTH=4.2

============= Hydrodynamic Parameters (HSCE) =============

PIER_VIBE_WAVE_HEIGHT=2.5
PIER_VIBE_WAVE_PERIOD=6.0
PIER_VIBE_CURRENT_VELOCITY=1.2

============= Fatigue Parameters (EFGL) =============

PIER_VIBE_FATIGUE_DETAIL_CATEGORY=B
PIER_VIBE_STRESS_CONCENTRATION=2.5

============= Safety Thresholds =============

PIER_VIBE_BSHI_MIN=0.85
PIER_VIBE_FREQUENCY_DRIFT_CRIT=5.0

============= AI Augmentation =============

PIER_VIBE_PINN_SCOUR_ENABLED=true
PIER_VIBE_PINN_FATIGUE_ENABLED=true
PIER_VIBE_FORECAST_HOURS=72

============= Logging & Archival =============

PIER_VIBE_LOG_LEVEL=INFO
PIER_VIBE_ARCHIVE_ENABLED=true
PIER_VIBE_ARCHIVE_DIR=./archive

============= Visualization =============

PIER_VIBE_VIZ_ENABLED=true
PIER_VIBE_VIZ_PORT=8501
